{
  "schemaVersion": 1,
  "id": "packcontrol",
  "version": "${version}",
  "name": "PackControl",
  "description": "A safe, transactional modpack updater for Minecraft 1.21.1.",
  "authors": [
    "waterflane"
  ],
  "contact": {
    "homepage": "https://github.com/waterflane/PackControl",
    "sources": "https://github.com/waterflane/PackControl",
    "issues": "https://github.com/waterflane/PackControl/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "main": [
      "org.wodichka.packcontrol.fabric.PackControlFabric"
    ]
  },
  "mixins": [
    "packcontrol-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*"
  }
}
